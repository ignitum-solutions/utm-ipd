{
  "name": "utm-ipd-playground",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run src",
    "test:browser": "playwright test",
    "format": "prettier --write src e2e index.html package.json playwright.config.ts tsconfig.json vite.config.ts",
    "format:check": "prettier --check src e2e index.html package.json playwright.config.ts tsconfig.json vite.config.ts"
  },
  "dependencies": {
    "katex": "^0.18.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "katex": "$katex"
  }
}
